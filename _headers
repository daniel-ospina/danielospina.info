/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Cache-Control on .css / .js / .woff2 is pinned to 4 hours by Pages itself and
# cannot be set here — a rule for these paths is silently ignored. scripts/deploy.sh
# fingerprints the stylesheet and script URLs instead. Only images can be given a
# long cache from this file.
